<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Capabilities, each with one purpose:
        - INTERNET: relay allowed DNS queries to the upstream resolver. Nothing else in
          the app opens a socket; there is no telemetry and no backend.
        - ACCESS_NETWORK_STATE: read-only check for an active VPN transport, used to tell
          "another VPN owns the tunnel" apart from "the interface could not be created".
          It grants no access to network content.
        - BIND_VPN_SERVICE on the filter service, so only the system can start it.
        The app still stores the blocklist on-device and never uploads it.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".LockSiteApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LockSite">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.LockSite">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Local DNS filter. Not exported and guarded by BIND_VPN_SERVICE, which only the
            system holds, so no other app can start or stop it directly.
        -->
        <service
            android:name=".vpn.LockSiteVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>
    </application>

</manifest>
